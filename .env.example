# Salin menjadi .env lalu isi. JANGAN unggah file .env ke internet.
NS_MODE=dev                         # ganti "prod" untuk produksi (sandi wajib diisi)
NS_OPERATOR_PASSWORD=ganti-dengan-sandi-panjang-minimal-12
NS_VIEWER_PASSWORD=ganti-dengan-sandi-lain-minimal-12
NS_AUDIT_KEY=ganti-dengan-64-karakter-acak   # buat: python -c "import secrets;print(secrets.token_hex(32))"
NS_AUDIT_FILE=data/audit_log.jsonl
NS_BUKTI_FILE=data/rantai_bukti.jsonl       # Fase 4: buku rantai bukti (kunci HMAC sama dengan log audit)
NS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
NS_ALLOWED_HOSTS=127.0.0.1,localhost
NS_HTTPS=0                          # isi 1 bila sudah memakai HTTPS (mengaktifkan HSTS)
NS_ZONA_WAKTU=WIB                   # zona waktu di LAPSIT PDF: WIB | WITA | WIT
# Fase 5 (manajemen akun)
NS_DAFTAR_PENGAMAT=1                # 1 = siapa pun boleh membuat akun pengamat sendiri; 0 = tutup
NS_KODE_OPERATOR=                   # kode undangan untuk mendaftar sebagai OPERATOR; kosong = pendaftaran operator mandiri ditutup
NS_AKUN_FILE=data/akun.json         # akun terdaftar (hanya garam + hash PBKDF2, tidak pernah sandi asli)
